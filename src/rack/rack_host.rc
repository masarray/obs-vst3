// Windows application icon for the isolated VST3 Rack helper.
// The ICO is generated from the maintainer-provided OBS_Studio_Logo.svg source
// and keeps the OBS artwork at 80% of the icon canvas so the helper reads as a
// smaller OBS companion/plugin application rather than the main OBS app.
// ID 101 is intentionally stable because rack_editor_window.cpp loads it for
// both the large and small window-class icons.
101 ICON "rack_host.ico"
